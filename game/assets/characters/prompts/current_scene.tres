[gd_resource type="Resource" script_class="PromptStack" load_steps=4 format=3 uid="uid://b4j2nqhwnkrxw"]

[ext_resource type="Script" uid="uid://bji3uvqm0d0ay" path="res://src/Mind/AI/Prompting/ProjectionPromptSection.cs" id="1_projection"]
[ext_resource type="Script" uid="uid://bcokws68yoalk" path="res://src/Mind/AI/Prompting/PromptStack.cs" id="2_stack"]

[sub_resource type="Resource" id="Resource_attended_characters"]
script = ExtResource("1_projection")
ProjectorID = "attended-characters"
RootTypeName = "AlleyCat.Mind.AI.SceneStatus.AttendedCharactersSceneStatus"
TemplateSource = "Current game time: {{ CurrentGameTime }}
{% if AttendedCharacters.size > 0 %}
Current attended characters:
{% for attended in AttendedCharacters %}- {{ attended.FullId }}{% if attended.RelativePosition != nil %} is {{ attended.RelativePosition.Distance }} m away (observed at {{ attended.RelativePositionObservedAt }} s){% endif %}{% if attended.VisualDescription != nil %}: {{ attended.VisualDescription }} (described at {{ attended.VisualDescriptionObservedAt }} s){% endif %}
{% endfor %}{% else %}
No characters are currently attended.
{% endif %}"
Name = "Attended Characters"

[sub_resource type="Resource" id="Resource_active_watches"]
script = ExtResource("1_projection")
ProjectorID = "active-watches"
RootTypeName = "AlleyCat.Mind.AI.SceneStatus.ActiveWatchesSceneStatus"
TemplateSource = "{% if Watches.size > 0 %}{% for watch in Watches %}- WatchId: {{ watch.WatchId }}, ConditionId: {{ watch.ConditionId }}, SubjectId: {{ watch.SubjectId }}
{% endfor %}{% endif %}"
Name = "Active Watches"

[resource]
script = ExtResource("2_stack")
Sections = [SubResource("Resource_attended_characters"), SubResource("Resource_active_watches")]
