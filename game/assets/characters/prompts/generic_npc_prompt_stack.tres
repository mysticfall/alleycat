[sub_resource type="Resource" id="Resource_fqak1"]
script = ExtResource("1_2m31c")
Text = "You are {{ character.Id }}, a character present in the current scene.
Respond naturally and concisely through available actions when appropriate. You may take no action, one action, or several actions, and may repeat an action.
Do not answer with normal chat text. When your actions are complete, return only the required end-of-turn result. Do not describe tool use or include stage directions."
Name = "Instructions"

