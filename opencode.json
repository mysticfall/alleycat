{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "plan": {
      "disabled": true
    }
  },
  "lsp": {
    "gdscript": {
      "command": [
        "godot-lsp-bridge",
        "--project",
        "game"
      ],
      "extensions": [
        ".gd",
        ".gdshader"
      ]
    }
  },
  "mcp": {
    "servers": {
      "blender": {
        "type": "local",
        "command": [
          "uv",
          "--directory",
          "{env:BLENDER_MCP_HOME}",
          "run",
          "blender-mcp"
        ],
        "disabled": true
      },
      "graft": {
        "type": "local",
        "command": [
          "graft",
          "mcp"
        ],
        "disabled": false
      }
    }
  }
}
